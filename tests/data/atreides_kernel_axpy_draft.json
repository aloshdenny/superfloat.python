   "  7  0x3444  ADD   R4, R4, R4    ; x8 (doubling, not MUL: MUL is 8x8 only)",
   "  8  0x344F  ADD   R4, R4, R15   ; i = global block * 8 + threadIdx",
   "  9  0x3116  ADD   R1, R1, R6",
   " 10  0x7210  LDR   R2, R1        ; R2 = x_ptr (slot 1)",
   " 11  0x3116  ADD   R1, R1, R6",
   " 12  0x7A10  LDR   R10, R1       ; R10 = y_ptr (slot 2)",
   " 13  0x3116  ADD   R1, R1, R6",
   " 14  0x7B10  LDR   R11, R1       ; R11 = out_ptr (slot 3)",
   " 15  0x3116  ADD   R1, R1, R6",
   " 16  0x7310  LDR   R3, R1        ; R3 = a, sign-magnitude sf16 (slot 4)",
   " 17  0x3524  ADD   R5, R2, R4    ; &x[i]",
   " 18  0x7550  LDR   R5, R5        ; x[i]",
   " 19  0x38A4  ADD   R8, R10, R4   ; &y[i]",
   " 20  0x7880  LDR   R8, R8        ; y[i], the FMA accumulator",
   " 21  0xA835  FMA   R8, R3, R5    ; R8 = y[i] + a * x[i]",
   " 22  0x39B4  ADD   R9, R11, R4   ; &out[i]",
   " 23  0x8980  STR   R9, R8        ; out[i] = R8",
   " 24  0xF000  RET"
