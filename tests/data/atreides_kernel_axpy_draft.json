 "kernel": "axpy",
 "source": [
  "@sf.jit",
  "def axpy(a, x_ptr, y_ptr, out_ptr, n):",
  "    i = sf.program_id(0) * 8 + sf.arange(0, 8)",
  "    sf.store(out_ptr + i, a * sf.load(x_ptr + i) + sf.load(y_ptr + i), mask=i < n)"
 ],
